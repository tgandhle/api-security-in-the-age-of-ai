# Generated files. They are committed so the published folder is complete
# without a build step, but they are not reviewed by reading the diff.
# Their correctness is checked by the tool that writes them:
#   content/lessons/**       tools/extract_lessons.py --check
#   content/pages.json       tools/extract_pages.py --check
#   assets/search-index.js   tools/build_search_index.py --check
#   labs/*.lab.js            tools/build_lab_bundles.py --check
#   checklist/index.html     tools/build_checklist.py --check
content/** linguist-generated=true
checklist/index.html linguist-generated=true
labs/*.lab.js linguist-generated=true
assets/search-index.js linguist-generated=true
